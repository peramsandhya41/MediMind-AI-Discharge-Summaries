# Optional outbound email notifications. Keep credentials private; never commit real secrets.
MEDIMIND_SMTP_HOST=smtp.gmail.com
MEDIMIND_SMTP_PORT=587
MEDIMIND_SMTP_FROM=your-sender@gmail.com
MEDIMIND_SMTP_PASSWORD=your-app-password
# Optional if the frontend is hosted on another origin
MEDIMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Optional hosted AI drafting (keep the key on the backend only)
MEDIMIND_AI_API_KEY=your-ai-api-key
MEDIMIND_AI_MODEL=gpt-4o-mini
# Or use local Ollama instead of a hosted AI provider
MEDIMIND_USE_OLLAMA=false
MEDIMIND_OLLAMA_MODEL=llama3.1
MEDIMIND_OLLAMA_URL=http://localhost:11434/api/generate
